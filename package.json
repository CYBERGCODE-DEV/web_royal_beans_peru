{
  "name": "royal-beans-peru",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:staging": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-hostinger.ps1 -Environment staging -BuildOnly",
    "build:production": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-hostinger.ps1 -Environment production -BuildOnly",
    "dist:staging": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-hostinger.ps1 -Environment staging",
    "dist:production": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-hostinger.ps1 -Environment production",
    "dist:hostinger": "npm run dist:staging",
    "start": "next start"
  },
  "dependencies": {
    "@tailwindcss/postcss": "latest",
    "lucide-react": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "tailwindcss": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest"
  }
}
